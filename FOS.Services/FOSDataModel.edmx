          <EntitySet Name="vActiveJobs" EntityType="Self.vActiveJobs" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [vActiveJobs].[TID] AS [TID], 
    [vActiveJobs].[ID] AS [ID], 
    [vActiveJobs].[JobTitle] AS [JobTitle], 
    [vActiveJobs].[RegionalHeadType] AS [RegionalHeadType], 
    [vActiveJobs].[RegionalHeadID] AS [RegionalHeadID], 
    [vActiveJobs].[VisitType] AS [VisitType], 
    [vActiveJobs].[RetailerType] AS [RetailerType], 
    [vActiveJobs].[SaleOfficerID] AS [SaleOfficerID], 
    [vActiveJobs].[CityID] AS [CityID], 
    [vActiveJobs].[Areas] AS [Areas], 
    [vActiveJobs].[Status] AS [Status], 
    [vActiveJobs].[VisitPlanType] AS [VisitPlanType], 
    [vActiveJobs].[VisitPlanDays] AS [VisitPlanDays], 
    [vActiveJobs].[JobType] AS [JobType], 
    [vActiveJobs].[DateOfAssign] AS [DateOfAssign], 
    [vActiveJobs].[DateOfCompletion] AS [DateOfCompletion], 
    [vActiveJobs].[StartingDate] AS [StartingDate], 
    [vActiveJobs].[CreatedDate] AS [CreatedDate], 
    [vActiveJobs].[LastUpdated] AS [LastUpdated], 
    [vActiveJobs].[IsActive] AS [IsActive], 
    [vActiveJobs].[IsDeleted] AS [IsDeleted], 
    [vActiveJobs].[LastProcessed] AS [LastProcessed]
    FROM [dbo].[vActiveJobs] AS [vActiveJobs]</DefiningQuery>
