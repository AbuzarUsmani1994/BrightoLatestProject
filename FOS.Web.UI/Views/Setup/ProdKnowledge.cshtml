@model FOS.Shared.AreaData
@{
    ViewBag.Title = "Product Knowledge & Competitor Activities";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <h3 class="page-title"></h3>
        <ul class="breadcrumb">
            <li>
                <a href="#">Setup</a>
                <span class="divider">/</span>
            </li>
            <li>
                <a href="#">Product Knowledge & Competitor Activities</a>
            </li>
        </ul>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget green">
            <div class="widget-title">
                <h4>Manage Product Knowledge &amp; Competitor Activities</h4>
                <span class="tools"></span>
            </div>
            <div class="widget-body">

                <div class="control-group">
                    <label class="control-label">Financial Year *</label>
                    <div class="controls">
                        @Html.DropDownListFor(model => model.FinancialYearID,
                            new SelectList(Model.FinancialYears ?? new List<FOS.Shared.FinancialYearListItem>(), "ID", "Year"),
                            "-- Select Financial Year --",
                            new { @id = "FinancialYearID" })
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label">Quarter *</label>
                    <div class="controls">
                        @Html.DropDownListFor(model => model.Quarter,
                            new SelectList(new List<SelectListItem>()),
                            "-- Select Quarter --",
                            new { @id = "Quarter" })
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label">Select Head *</label>
                    <div class="controls">
                        @Html.DropDownListFor(model => model.RegionID,
                            new SelectList(Model.RegionalHead ?? new List<FOS.Shared.RegionalHeadData>(), "ID", "Name"),
                            "-- Select Regional Head --",
                            new { @id = "RegionID" })
                    </div>
                </div>

                <div class="control-group">
                    <div class="controls" style="margin-left:0">
                        <table class="table table-striped table-hover table-bordered" id="pkRowsTable" style="width:100%;">
                            <thead>
                                <tr>
                                    <th style="width:50%">SO Name</th>
                                    <th>Product Knowledge</th>
                                    <th>Competitor Activities</th>
                                </tr>
                            </thead>
                            <tbody id="pkRowsBody">
                                <tr><td colspan="3" style="text-align:center;color:#888">Select a Regional Head to load SOs</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="control-group" style="border-top: 1px solid #e5e5e5;">
                    <div class="form-actions" style="padding-left:238px">
                        <button type="button" id="btnSaveAll" class="btn btn-primary">
                            <i class="icon-ok icon-white" style="padding-right:8px"></i>Save All
                        </button>
                        <button type="button" id="btnRefresh" class="btn btn-info">
                            <i class="icon-ban-circle icon-white" style="padding-right:8px"></i>Reset
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget green">
            <div class="widget-title">
                <h4>View Detail</h4>
                <span class="tools"></span>
            </div>
            <div class="widget-body">
                <div>
                    <div class="clearfix">
                        <div class="btn-group pull-right">
                            <button type="button" id="btnExport" class="btn btn-success">
                                <i class="icon-download-alt icon-white" style="padding-right:6px"></i>Export
                            </button>
                        </div>
                    </div>
                    <div class="space15"></div>
                    <table class="table table-striped table-hover table-bordered" id="datatab" style="width:100%;">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th style="width:6% !important">Sr #</th>
                                <th>Financial Year</th>
                                <th>Quarter</th>
                                <th>Head Name</th>
                                <th>SO Name</th>
                                <th>Product Knowledge</th>
                                <th>Competitor Activities</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function LoadSORows() {
        var rhID = $('#RegionID').val();
        var $body = $('#pkRowsBody');
        $body.empty();

        if (!rhID || rhID === '') {
            $body.html('<tr><td colspan="3" style="text-align:center;color:#888">Select a Regional Head to load SOs</td></tr>');
            return;
        }

        $.ajax({
            url: '@Url.Action("GetSOByRegionalHeadID", "Setup")',
            type: 'GET',
            data: { RegionalHeadID: rhID },
            success: function (sos) {
                sos = sos || [];
                if (sos.length === 0) {
                    $body.html('<tr><td colspan="3" style="text-align:center;color:#888">No active SOs under selected head</td></tr>');
                    return;
                }
                $.each(sos, function (i, s) {
                    var $row = $(
                        '<tr>' +
                            '<td>' + s.Name + '<input type="hidden" class="pk-so" value="' + s.ID + '" /></td>' +
                            '<td><input type="number" min="0" step="any" class="pk-value" style="width:100%" value="0" /></td>' +
                            '<td><input type="number" min="0" step="any" class="cf-value" style="width:100%" value="0" /></td>' +
                        '</tr>'
                    );
                    $body.append($row);
                });
            },
            error: function () {
                $body.html('<tr><td colspan="3" style="text-align:center;color:#c00">Failed to load SOs</td></tr>');
            }
        });
    }

    function CollectRows() {
        var rows = [];
        $('#pkRowsBody tr').each(function () {
            var soInp = $(this).find('.pk-so');
            if (soInp.length === 0) return;
            rows.push({
                SOID: parseInt(soInp.val()) || 0,
                ProductKnowledge: parseFloat($(this).find('.pk-value').val()) || 0,
                CompFeed: parseFloat($(this).find('.cf-value').val()) || 0
            });
        });
        return rows;
    }

    function SaveAll() {
        var fy = $('#FinancialYearID').val();
        var q  = $('#Quarter').val();
        var rh = $('#RegionID').val();
        if (!fy) { alertify.error("Please select Financial Year"); return; }
        if (!q)  { alertify.error("Please select Quarter"); return; }
        if (!rh) { alertify.error("Please select Regional Head"); return; }

        var rows = CollectRows();
        if (rows.length === 0) { alertify.error("No SO rows to save"); return; }

        var payload = {
            FinancialYearID: parseInt(fy),
            Quarter: q,
            RegionID: parseInt(rh),
            ProdKnowledgeRows: rows
        };

        $.ajax({
            url: '@Url.Action("SaveProdKnowledgeBulk", "Setup")',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response === "1") {
                    alertify.success("Saved Successfully");
                    GenerateDetailGrid();
                    ClearForm();
                } else {
                    alertify.error("Unable to save. Please check input.");
                }
            },
            error: function () { alertify.error("Server error. Please try again."); }
        });
    }

    function GenerateDetailGrid() {
        if ($.fn.DataTable.isDataTable('#datatab')) {
            $('#datatab').DataTable().destroy();
            $('#datatab tbody').empty();
        }

        $('#datatab').DataTable({
            "aLengthMenu": [[10, 25, 50, 75, 100], [10, 25, 50, 75, 100]],
            "iDisplayLength": 10,
            "paging": true,
            "pagingType": "full_numbers",
            "serverSide": true,
            "bRetrieve": true,
            "bDestroy": true,
            "autoWidth": true,
            "ajax": {
                "type": "POST",
                "url": '@Url.Action("AddProdKnowledgeDataHandler", "Setup")',
                "contentType": 'application/json; charset=utf-8',
                "dataType": "json",
                "data": function (d) {
                    d.RegionalHeadID  = $('#RegionID').val() || 0;
                    d.FinancialYearID = $('#FinancialYearID').val() || 0;
                    d.Quarter         = $('#Quarter').val() || '';
                    return JSON.stringify(d);
                }
            },
            "columns": [
                { "data": "ID", "bVisible": false },
                {
                    "data": null, "bSortable": false,
                    "render": function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                { "data": "FinancialYearName" },
                { "data": "Quarter" },
                { "data": "HeadName" },
                { "data": "SOName" },
                { "data": "ProductKnowledge" },
                { "data": "CompFeed" },
                {
                    "data": "ID", "bSortable": false,
                    "render": function (data) {
                        return '<button class="btn btn-xs btn-warning" onclick="editRecord(' + data + ')"><i class="icon-pencil"></i> Edit</button> ' +
                               '<button class="btn btn-xs btn-danger"  onclick="deleteRecord(' + data + ')"><i class="icon-trash"></i> Delete</button>';
                    }
                }
            ],
            "language": {
                "sSearch": "Search: ",
                "processing": '<i class="fa fa-spinner fa-spin fa-3x fa-fw"></i> Loading...',
                "emptyTable": "No data available",
                "zeroRecords": "No matching records found"
            },
            "sDom": 'lftipr',
            "order": [[1, "asc"]]
        });
    }

    function ClearForm() {
        $('#FinancialYearID').val('');
        $('#Quarter').empty().append('<option value="">-- Select Quarter --</option>');
        $('#RegionID').val('');
        $('#pkRowsBody').html('<tr><td colspan="3" style="text-align:center;color:#888">Select a Regional Head to load SOs</td></tr>');
    }

    function deleteRecord(id) {
        if (!confirm('Are you sure you want to delete this record?')) return;
        $.post('@Url.Action("DeleteProdKnowledgeRecord", "Setup")', { id: id }, function (res) {
            if (res.success) {
                alertify.success('Record deleted successfully');
                $('#datatab').DataTable().ajax.reload();
            } else {
                alertify.error(res.message || 'Delete failed');
            }
        });
    }

    function editRecord(id) {
        $.get('@Url.Action("GetProdKnowledgeRecord", "Setup")', { id: id }, function (res) {
            if (!res.success) { alertify.error('Failed to load record'); return; }
            $('#editRecordId').val(res.id);
            $('#editPKValue').val(res.pk);
            $('#editCFValue').val(res.cf);
            $('#editModal').modal('show');
        });
    }

    $(document).ready(function () {
        $("#liSetup,#liProdKnowledge").addClass("active");

        $("#FinancialYearID").change(function () {
            var fyid = $(this).val();
            $('#Quarter').empty().append('<option value="">-- Select Quarter --</option>');
            if (fyid && fyid !== '') {
                $.get('@Url.Action("GetQuartersByFinancialYear", "Setup")', { financialYearID: fyid }, function (data) {
                    $.each(data, function (i, q) {
                        $('#Quarter').append('<option value="' + q.Name + '">' + q.Name + '</option>');
                    });
                });
            }
            GenerateDetailGrid();
        });

        $("#Quarter").change(function () { GenerateDetailGrid(); });

        $("#RegionID").change(function () {
            GenerateDetailGrid();
            LoadSORows();
        });

        $("#btnRefresh").click(function () { ClearForm(); });
        $("#btnSaveAll").click(function () { SaveAll(); });

        GenerateDetailGrid();

        $("#btnExport").click(function () {
            var fy = $('#FinancialYearID').val() || 0;
            var q  = $('#Quarter').val() || '';
            var rh = $('#RegionID').val() || 0;
            window.location.href = '@Url.Action("ExportProdKnowledgeReport", "Setup")?RegionalHeadID=' + rh + '&FinancialYearID=' + fy + '&Quarter=' + encodeURIComponent(q);
        });

        $('#btnSaveEdit').click(function () {
            var id      = $('#editRecordId').val();
            var pkValue = $('#editPKValue').val();
            var cfValue = $('#editCFValue').val();
            if (pkValue === '' || isNaN(pkValue)) { alertify.error('Please enter a valid Product Knowledge value'); return; }
            if (cfValue === '' || isNaN(cfValue)) { alertify.error('Please enter a valid Competitor Activities value'); return; }
            $.post('@Url.Action("UpdateProdKnowledgeRecord", "Setup")', { id: id, pkValue: pkValue, cfValue: cfValue }, function (res) {
                if (res.success) {
                    alertify.success('Record updated successfully');
                    $('#editModal').modal('hide');
                    $('#datatab').DataTable().ajax.reload();
                } else {
                    alertify.error(res.message || 'Update failed');
                }
            });
        });
    });
</script>

<div class="modal hide fade" id="editModal" tabindex="-1" style="width:380px;left:50%;margin-left:-190px;top:20%;height:auto;border-radius:8px;overflow:hidden;">
    <div class="modal-header" style="background:#27ae60;padding:11px 15px;">
        <button type="button" class="close" data-dismiss="modal" style="color:#fff;opacity:1;font-size:18px;line-height:1;">&times;</button>
        <h4 style="color:#fff;margin:0;font-size:14px;font-weight:600;"><i class="icon-pencil" style="margin-right:6px;"></i>Edit Record</h4>
    </div>
    <div class="modal-body" style="padding:18px 20px;">
        <input type="hidden" id="editRecordId" />
        <label style="font-size:11px;color:#888;font-weight:700;letter-spacing:1px;margin-bottom:5px;display:block;">PRODUCT KNOWLEDGE</label>
        <input type="number" id="editPKValue" step="any" min="0" style="width:100%;padding:9px 12px;font-size:15px;border:2px solid #27ae60;border-radius:5px;box-sizing:border-box;outline:none;margin-bottom:12px;" />
        <label style="font-size:11px;color:#888;font-weight:700;letter-spacing:1px;margin-bottom:5px;display:block;">COMPETITOR ACTIVITIES</label>
        <input type="number" id="editCFValue" step="any" min="0" style="width:100%;padding:9px 12px;font-size:15px;border:2px solid #27ae60;border-radius:5px;box-sizing:border-box;outline:none;" />
    </div>
    <div class="modal-footer" style="padding:10px 15px;background:#f5f5f5;border-top:1px solid #e0e0e0;text-align:right;">
        <button class="btn btn-small" data-dismiss="modal" style="margin-right:6px;">Cancel</button>
        <button class="btn btn-small btn-primary" id="btnSaveEdit" style="background:#27ae60;border-color:#219a52;font-weight:600;padding:5px 18px;">Save</button>
    </div>
</div>
