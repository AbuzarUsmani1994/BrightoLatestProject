@model FOS.Web.UI.Controllers.SetupController.KPIReportModel
@{
    ViewBag.Title = "Employee Performance Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    #FinancialYearID,
    #Quarter,
    #RegionalHeadID,
    #SOID {
        color: #008000;
    }

    #FinancialYearID option,
    #Quarter option,
    #RegionalHeadID option,
    #SOID option {
        color: #008000;
    }
</style>

<div class="row-fluid">
    <div class="span12">
        <h3 class="page-title"></h3>
        <ul class="breadcrumb">
            <li><a href="#">Setup</a><span class="divider">/</span></li>
            <li class="active">Employee Performance Report</li>
        </ul>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget-box">
            <div class="widget-title">
                <span class="icon"><i class="icon-th"></i></span>
                <h5>Employee Performance Report</h5>
            </div>
            <div class="widget-content nopadding">
                <div class="form-horizontal" style="padding:15px;">
                    <div class="control-group">
                        <label class="control-label">Financial Year</label>
                        <div class="controls">
                            <select id="FinancialYearID" name="FinancialYearID" class="span3">
                                <option value="">-- Select Financial Year --</option>
                                @foreach (var fy in Model.FinancialYears)
                                {
                                    <option value="@fy.ID">@fy.Year</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Quarter</label>
                        <div class="controls">
                            <select id="Quarter" name="Quarter" class="span3">
                                <option value="">-- Select Quarter --</option>
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Regional Head</label>
                        <div class="controls">
                            <select id="RegionalHeadID" name="RegionalHeadID" class="span3">
                                <option value="0">-- All --</option>
                                @foreach (var rh in Model.RegionalHeads)
                                {
                                    <option value="@rh.ID">@rh.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Sales Officer</label>
                        <div class="controls">
                            <select id="SOID" name="SOID" class="span3">
                                <option value="0">-- All --</option>
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <div class="controls">
                            <button type="button" id="btnGenerate" class="btn btn-primary">
                                <i class="icon-file"></i> Generate Report (PDF)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $("#FinancialYearID").change(function () {
        var fyid = $(this).val();
        $('#Quarter').empty().append('<option value="">-- Select Quarter --</option>');
        if (fyid && fyid !== '') {
            $.get('@Url.Action("GetQuartersByFinancialYear", "Setup")', { financialYearID: fyid }, function (data) {
                $.each(data, function (i, q) {
                    $('#Quarter').append('<option value="' + q.Name + '">' + q.Name + '</option>');
                });
            });
        }
    });

    $("#RegionalHeadID").change(function () {
        var rhid = $(this).val() || 0;
        $('#SOID').empty();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetAllSaleOfficerSelectOption", "Job")',
            data: { regionalHeadId: rhid },
            success: function (data) {
                $.each(data, function (i, so) {
                    var text = so.SaleOfficerID == 0 ? '-- All --' : so.SaleOfficerName;
                    $('#SOID').append('<option value="' + so.SaleOfficerID + '">' + text + '</option>');
                });
            }
        });
    });

    $("#RegionalHeadID").trigger("change");

    $("#btnGenerate").click(function () {
        var fyid = $('#FinancialYearID').val();
        var quarter = $('#Quarter').val();
        var rhid = $('#RegionalHeadID').val() || 0;
        var soid = $('#SOID').val() || 0;

        if (!fyid || fyid === '') {
            alertify.alert('Please select a Financial Year.');
            return;
        }
        if (!quarter || quarter === '') {
            alertify.alert('Please select a Quarter.');
            return;
        }

        window.open('@Url.Action("EmployeePerformanceReportPrint", "Setup")?FinancialYearID=' + fyid + '&Quarter=' + encodeURIComponent(quarter) + '&RegionalHeadID=' + rhid + '&SOID=' + soid, '_blank');
    });
</script>
