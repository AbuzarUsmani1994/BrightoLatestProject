@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Style/jquery-ui.min.css" rel="stylesheet" />
<script src='~/Scripts/lib/moment.min.js'></script>
<script src='~/Scripts/lib/jquery-ui.min.js'></script>

<!-- BEGIN PAGE HEADER-->
<div class="row-fluid">
    <div class="span12">
        <h3 class="page-title"></h3>
        <ul class="breadcrumb">
            <li>
                <a href="#">Welcome SMS Report</a>
            </li>
        </ul>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget green" style="min-height: 100px;">
            <div class="widget-title">
                <h4>Welcome SMS Report</h4>
                <span class="tools"></span>
            </div>
            <div class="widget-body" style="min-height: 100px; padding: 20px;">
                <div style="display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-end;">

                    <div>
                        <label class="control-label" style="font-weight: 700; color: #b94a48; margin-bottom: 5px;">Starting Date *</label>
                        <input class="text-box single-line" id="StartingDate1" name="StartingDate1" style="height: 22px; width: 160px; margin-bottom: 0px;">
                    </div>

                    <div>
                        <label class="control-label" style="font-weight: 700; color: #b94a48; margin-bottom: 5px;">Ending Date *</label>
                        <input class="text-box single-line" id="StartingDate2" name="StartingDate2" style="height: 22px; width: 160px; margin-bottom: 0px;">
                    </div>

                    <div>
                        <button type="button" id="btnSearch" class="btn btn-primary">
                            <i class="icon-search icon-white" style="padding-right: 8px"></i><span>Search</span>
                        </button>
                        <button type="button" id="btnExport" class="btn btn-success">
                            <i class="icon-download-alt icon-white"></i> Export (Excel)
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget-box">
            <div class="widget-title">
                <span class="icon"><i class="icon-th"></i></span>
                <h5>Welcome SMS Log</h5>
            </div>
            <div class="widget-content nopadding">
                <div style="padding:15px;">
                    <table class="table table-striped table-hover table-bordered" id="datatab" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Message</th>
                                <th>Status</th>
                                <th>Error Detail</th>
                                <th>Sent On</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('#StartingDate1').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            yearRange: '1950:2100'
        });

        $('#StartingDate2').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            yearRange: '1950:2100'
        });

        // Default to today, so the report shows something on first load.
        var today = new Date();
        $('#StartingDate1').datepicker('setDate', today);
        $('#StartingDate2').datepicker('setDate', today);

        function LoadWelcomeSmsReport() {
            var sdate = $("#StartingDate1").val();
            var edate = $("#StartingDate2").val();
            if (sdate == "") {
                alertify.error("Please Enter Starting Date");
                return;
            }
            if (edate == "") {
                alertify.error("Please Enter Ending Date");
                return;
            }

            $.ajax({
                type: "GET",
                url: '@Url.Action("WelcomeSmsReportData", "Reports")',
                data: { StartingDate: sdate, EndingDate: edate },
                success: function (result) {
                    if (result.error) {
                        alertify.error(result.error);
                        return;
                    }

                    if ($.fn.DataTable.isDataTable('#datatab')) {
                        $('#datatab').DataTable().destroy();
                    }
                    $('#datatab tbody').empty();

                    $('#datatab').DataTable({
                        "aLengthMenu": [[10, 25, 50, 75, 100], [10, 25, 50, 75, 100]],
                        "iDisplayLength": 10,
                        "pagingType": "full_numbers",
                        "autoWidth": true,
                        "data": result.data,
                        "columns": [
                            { "data": "CustomerName" },
                            { "data": "PhoneNo" },
                            { "data": "Message" },
                            {
                                "data": "Status",
                                "render": function (data) {
                                    var color = data === "Sent" ? "#468847" : "#b94a48";
                                    return '<span style="color:' + color + '; font-weight:600;">' + data + '</span>';
                                }
                            },
                            { "data": "ErrorDetail" },
                            { "data": "CreatedOn" }
                        ]
                    });
                },
                error: function () {
                    alertify.error("Failed to load the welcome SMS log.");
                }
            });
        }

        $("#btnSearch").click(function () {
            LoadWelcomeSmsReport();
        });

        $("#btnExport").click(function () {
            var sdate = $("#StartingDate1").val();
            var edate = $("#StartingDate2").val();
            if (sdate == "" || edate == "") {
                alertify.error("Please select both a Starting and Ending Date before exporting.");
                return;
            }
            window.location.href = '@Url.Action("WelcomeSmsReportExport", "Reports")?StartingDate=' + encodeURIComponent(sdate) + '&EndingDate=' + encodeURIComponent(edate);
        });

        LoadWelcomeSmsReport();
    });
</script>
