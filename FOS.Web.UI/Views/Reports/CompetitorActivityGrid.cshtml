@model FOS.Shared.JobsData

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Style/jquery-ui.min.css" rel="stylesheet" />
<script src='~/Scripts/lib/moment.min.js'></script>
<script src='~/Scripts/lib/jquery-ui.min.js'></script>

<style>
    #competitorVideoModal .modal-header {
        background-color: #376892;
        color: white;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        padding: 1rem 1.25rem;
    }

        #competitorVideoModal .modal-header .close {
            color: white;
            opacity: 1;
            font-size: 1.5rem;
        }

    #competitorVideoModal .modal-body video {
        width: 100%;
        max-height: 75vh;
        border-radius: 6px;
        background: #000;
    }
</style>

<!-- BEGIN PAGE HEADER-->
<div class="row-fluid">
    <div class="span12">
        <h3 class="page-title"></h3>
        <ul class="breadcrumb">
            <li>
                <a href="#">Competitor Activity Grid</a>
            </li>
        </ul>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget green" style="min-height: 100px;">
            <div class="widget-title">
                <h4>Competitor Activity Grid</h4>
                <span class="tools"></span>
            </div>
            <div class="widget-body" style="min-height: 100px;">
                <div class="span5">

                    <div class="control-group" style="margin-bottom: 14px;">
                        <label class="control-label">Starting Date *</label>
                        <div class="controls">
                            <input class="text-box single-line" id="StartingDate1" name="StartingDate1" style="height: 22px; width: 202px; margin-bottom: 0px;">
                        </div>
                    </div>

                    <div class="control-group" style="margin-bottom: 14px;">
                        <label class="control-label">Ending Date *</label>
                        <div class="controls">
                            <input class="text-box single-line" id="StartingDate2" name="StartingDate2" style="height: 22px; width: 202px; margin-bottom: 0px;">
                        </div>
                    </div>

                    <div class="control-group">
                        <label class="control-label">Select Head *</label>
                        <div class="controls">
                            @Html.DropDownListFor(model => model.RegionalHeadID, new SelectList(Model.RegionalHead, "ID", "Name"), new { @class = "" })
                        </div>
                    </div>

                    <div class="control-group" style="margin-bottom: 14px;">
                        <label class="control-label">Sales Officer *</label>
                        <div class="controls">
                            @Html.DropDownListFor(model => model.SaleOfficerID, new SelectList(Model.SaleOfficer, "ID", "Name"), new { @class = "" })
                        </div>
                    </div>

                    <div class="control-group" style="border-top: 1px solid #e5e5e5;">
                        <div class="form-actions" style="padding-left: 130px; padding-right: 0px;">
                            <button type="button" id="btnSearch" class="btn btn-primary">
                                <i class="icon-search icon-white" style="padding-right: 8px"></i><span>Search</span>
                            </button>
                        </div>
                    </div>

                </div>
                <div class="span5"></div>
            </div>
        </div>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget-box">
            <div class="widget-title">
                <span class="icon"><i class="icon-th"></i></span>
                <h5>Competitor Activities</h5>
            </div>
            <div class="widget-content nopadding">
                <div style="padding:15px;">
                    <table class="table table-striped table-hover table-bordered" id="datatab" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Submitted Date</th>
                                <th>Regional Head</th>
                                <th>SO Name</th>
                                <th>Zone</th>
                                <th>City</th>
                                <th>Activity Type</th>
                                <th>Competitor Name</th>
                                <th>Remarks</th>
                                <th>Video</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Video Modal -->
<div id="competitorVideoModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="icon-film" style="margin-right: 8px;"></i> Competitor Activity Video
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <video id="competitorVideoPlayer" controls>
                    <source id="competitorVideoSource" src="" type="video/mp4">
                    Your browser does not support video playback.
                </video>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('#StartingDate1').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            yearRange: '1950:2100'
        });

        $('#StartingDate2').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            yearRange: '1950:2100'
        });

        function LoadSaleOfficersForCompetitorGrid() {
            var RegionalHeadID = $("#RegionalHeadID").val();
            $.ajax({
                type: "POST",
                data: { RegionalHeadID: RegionalHeadID, selectOption: true },
                url: "@Url.Action("GetAllSaleOfficerListRelatedToDealerSelectOption", "Job")",
                success: function (json) {
                    var $el = $("#SaleOfficerID");
                    $el.empty();
                    $.each(json, function (value, key) {
                        $el.append($("<option></option>")
                                .val(key.SaleOfficerID).text(key.SaleOfficerName));
                    });
                }
            });
        }

        $("#RegionalHeadID").change(function () {
            LoadSaleOfficersForCompetitorGrid();
        });

        function playCompetitorVideo(url) {
            var $player = $('#competitorVideoPlayer')[0];
            $('#competitorVideoSource').attr('src', url);
            $player.load();
            $('#competitorVideoModal').modal('show');
        }

        // Stop playback once the modal is closed, instead of leaving it running hidden.
        $('#competitorVideoModal').on('hidden.bs.modal hidden', function () {
            var $player = $('#competitorVideoPlayer')[0];
            $player.pause();
            $('#competitorVideoSource').attr('src', '');
            $player.load();
        });

        function LoadCompetitorGrid() {
            var sdate = $("#StartingDate1").val();
            var edate = $("#StartingDate2").val();
            if (sdate == "") {
                alertify.error("Please Enter Starting Date");
                return;
            }
            if (edate == "") {
                alertify.error("Please Enter Ending Date");
                return;
            }

            var TID = $("#RegionalHeadID").val();
            var fosid = $("#SaleOfficerID").val();

            $.ajax({
                type: "GET",
                url: '@Url.Action("CompetitorActivityGridData", "Reports")',
                data: { StartingDate: sdate, EndingDate: edate, TID: TID, fosid: fosid },
                success: function (result) {
                    if (result.error) {
                        alertify.error(result.error);
                        return;
                    }

                    if ($.fn.DataTable.isDataTable('#datatab')) {
                        $('#datatab').DataTable().destroy();
                    }
                    $('#datatab tbody').empty();

                    $('#datatab').DataTable({
                        "aLengthMenu": [[10, 25, 50, 75, 100], [10, 25, 50, 75, 100]],
                        "iDisplayLength": 10,
                        "pagingType": "full_numbers",
                        "autoWidth": true,
                        "data": result.data,
                        "columns": [
                            { "data": "SubmittedDate" },
                            { "data": "RegionalHead" },
                            { "data": "SOName" },
                            { "data": "Zone" },
                            { "data": "City" },
                            { "data": "ActivityType" },
                            { "data": "CompetitorName" },
                            { "data": "Remarks" },
                            {
                                "data": "VideoUrl",
                                "orderable": false,
                                "render": function (data, type, row) {
                                    if (!row.HasVideo) {
                                        return '<span class="muted">No video</span>';
                                    }
                                    return '<button type="button" class="btn btn-small btn-primary play-competitor-video" data-video-url="' + data + '">' +
                                        '<i class="icon-play icon-white"></i> Play</button>';
                                }
                            }
                        ]
                    });
                },
                error: function () {
                    alertify.error("Failed to load competitor activities.");
                }
            });
        }

        $('#datatab').on('click', '.play-competitor-video', function () {
            playCompetitorVideo($(this).data('video-url'));
        });

        $("#btnSearch").click(function () {
            LoadCompetitorGrid();
        });

    });
</script>
