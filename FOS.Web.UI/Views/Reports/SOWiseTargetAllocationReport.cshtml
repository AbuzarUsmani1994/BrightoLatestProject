@model FOS.Shared.CityData
@{
    ViewBag.Title = "SO Wise Target Allocation Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <h3 class="page-title"></h3>
        <ul class="breadcrumb">
            <li><a href="#">Reports</a><span class="divider">/</span></li>
            <li class="active">SO Wise Target Allocation Report</li>
        </ul>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget-box">
            <div class="widget-title">
                <span class="icon"><i class="icon-th"></i></span>
                <h5>SO Wise Target Allocation Report</h5>
            </div>
            <div class="widget-content nopadding">
                <div class="form-horizontal" style="padding:15px;">
                    <div class="control-group">
                        <label class="control-label">Financial Year</label>
                        <div class="controls">
                            <select id="FinancialYearID" name="FinancialYearID" class="span3">
                                <option value="">-- All --</option>
                                @foreach (var fy in (Model.FinancialYears ?? new List<FOS.Shared.FinancialYearListItem>()))
                                {
                                    <option value="@fy.ID">@fy.Year</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Regional Head</label>
                        <div class="controls">
                            <select id="RegionalHeadID" name="RegionalHeadID" class="span3">
                                <option value="0">-- All --</option>
                                @foreach (var rh in (Model.RegionalHeads ?? new List<FOS.Shared.RegionalHeadData>()))
                                {
                                    <option value="@rh.ID">@rh.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Sales Officer</label>
                        <div class="controls">
                            <select id="SOID" name="SOID" class="span3">
                                @foreach (var so in (Model.SaleOfficers ?? new List<FOS.Shared.SaleOfficer>()))
                                {
                                    <option value="@so.ID">@so.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <div class="controls">
                            <button type="button" id="btnSearch" class="btn btn-primary">
                                <i class="icon-search icon-white"></i> Search
                            </button>
                            <button type="button" id="btnExport" class="btn btn-success">
                                <i class="icon-download-alt icon-white"></i> Export (CSV)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row-fluid">
    <div class="span12">
        <div class="widget-box">
            <div class="widget-title">
                <span class="icon"><i class="icon-th"></i></span>
                <h5>View Detail</h5>
            </div>
            <div class="widget-content nopadding">
                <div style="padding:15px;">
                    <table class="table table-striped table-hover table-bordered" id="datatab" style="width: 100%;">
                        <thead>
                            <tr>
                                <th style="width:6%">Sr #</th>
                                <th>Financial Year</th>
                                <th>Regional Head</th>
                                <th>SO Name</th>
                                <th>Platinum</th>
                                <th>Premium</th>
                                <th>Gold</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function LoadSOOptions(regionalHeadID) {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetSOByRegionalHeadID", "Setup")',
            data: { RegionalHeadID: regionalHeadID || 0 },
            success: function (list) {
                var $sel = $('#SOID');
                $sel.empty();
                $sel.append('<option value="0">-- All --</option>');
                $.each(list, function (i, so) {
                    $sel.append('<option value="' + so.ID + '">' + so.Name + '</option>');
                });
            }
        });
    }

    function GenerateDetailGrid() {
        if ($.fn.DataTable.isDataTable('#datatab')) {
            $('#datatab').DataTable().destroy();
        }

        $('#datatab').DataTable({
            "aLengthMenu": [[10, 25, 50, 75, 100], [10, 25, 50, 75, 100]],
            "iDisplayLength": 10,
            "paging": true,
            "pagingType": "full_numbers",
            "serverSide": true,
            "bRetrieve": true,
            "bDestroy": true,
            "autoWidth": true,
            "ajax": {
                "type": "POST",
                "url": '@Url.Action("SOWiseTargetAllocationDataHandler", "Reports")',
                "contentType": "application/json; charset=utf-8",
                "data": function (data) {
                    data.FinancialYearID = $('#FinancialYearID').val() || 0;
                    data.RegionalHeadID = $('#RegionalHeadID').val() || 0;
                    data.SOID = $('#SOID').val() || 0;
                    return data = JSON.stringify(data);
                }
            },
            "fnRowCallback": function (nRow, aData, iDisplayIndex) {
                $("td:first", nRow).html(iDisplayIndex + 1);
                return nRow;
            },
            "oLanguage": { "sSearch": "Search : " },
            "sDom": 'lftipr',
            "processing": true,
            "deferRender": true,
            "columns": [
                { "data": "ID", "bSortable": false },
                { "data": "FinancialYearName" },
                { "data": "RegionalHeadName" },
                { "data": "SOName" },
                { "data": "CoatingTarget" },
                { "data": "ACTDTarget" },
                { "data": "ReadyMixTarget" },
                { "data": "TotalTarget" }
            ],
            "order": [1, "asc"]
        });
    }

    $(document).ready(function () {
        $("#liReports").addClass("active");

        GenerateDetailGrid();

        $("#RegionalHeadID").change(function () {
            LoadSOOptions($(this).val());
        });

        $("#btnSearch").click(function () {
            GenerateDetailGrid();
        });

        $("#btnExport").click(function () {
            var fy = $('#FinancialYearID').val() || 0;
            var rh = $('#RegionalHeadID').val() || 0;
            var so = $('#SOID').val() || 0;
            window.location.href = '@Url.Action("ExportSOWiseTargetAllocationReport", "Reports")?SOID=' + so + '&FinancialYearID=' + fy + '&RegionalHeadID=' + rh;
        });
    });
</script>
