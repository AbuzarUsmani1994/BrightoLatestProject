                                <thead>
                                    <tr>
                                        <th>Application Cause</th>
                                        <th>Substrate Cause</th>
                                        <th>Product Quality</th>
                                        <th>Remarks</th>
                                        <th>Status</th>
                                        <th>Complaint Status</th>
                                        <th>Image</th>
                                        <th>Video</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
