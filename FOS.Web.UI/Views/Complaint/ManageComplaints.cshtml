</div>
<script src="~/Scripts/js/preview.js"></script>
<script>
    // Publish button on each Quality Review history row is only for userID 1124 -
    // everyone else never sees it, even though the real gate is server-side
    // (ComplaintController.PublishComplaintSuggestion checks the same userID).
    var canPublish = @(Convert.ToString(Session["UserID"]) == "1124" ? "true" : "false");

    $(document).ready(function () {

        $('#StartingDate1').datepicker(
            {
                dateFormat: 'dd-M-yy',
                changeMonth: true,
                changeYear: true,
                yearRange: '1950:2100'
            });

        $('#StartingDate2').datepicker(
            {
                dateFormat: 'dd-M-yy',
                changeMonth: true,
                changeYear: true,
                yearRange: '1950:2100'
            });

        GenerateDetailGrid();
        $("#ProductDetail").modal('hide');

        $("#AppID").select2({
            width: "100%",
            placeholder: "Select",
            allowClear: true
        });
        $("#SubsID").select2({
            width: "100%",
            placeholder: "Select",
            allowClear: true
        });
        $("#QuaID").select2({
            width: "100%",
            placeholder: "Select",
            allowClear: true
        });

        $("#OtherApplication1").hide();
        $("#OtherSubstrate1").hide();
        $("#OtherQuality1").hide();


        //$("#AppID").change(function () {
        //    var appID = $("#AppID").val();
        //    var text = $(this).find(':selected').text();
        //    alertify.success(text);
        //});

        $("#AppID").on("select2-selecting", function (e) {
            var newValue = e.object.id;   // sirf new value
            if (newValue == "20") {
                $("#OtherApplication1").show();
            }
        });

        $("#AppID").on("select2-removing", function (e) {

            // safe way (v3 compatible)
            var removedValue = e.val || (e.object && e.object.id);

            if (removedValue == "20") {
                $("#OtherApplication1").hide();
                $("#OtherApplication").val(""); // optional clear
            }
        });

        $("#SubsID").on("select2-selecting", function (e) {
            var newValue = e.object.id;   // sirf new value
            if (newValue == "17") {
                $("#OtherSubstrate1").show();
            }
        });

        $("#SubsID").on("select2-removing", function (e) {

            // safe way (v3 compatible)
            var removedValue = e.val || (e.object && e.object.id);

            if (removedValue == "17") {
                $("#OtherSubstrate1").hide();
                $("#OtherSubstrate").val(""); // optional clear
            }
        });

        $("#QuaID").on("select2-selecting", function (e) {
            var newValue = e.object.id;   // sirf new value
            if (newValue == "28") {
                $("#OtherQuality1").show();
            }
        });

        $("#QuaID").on("select2-removing", function (e) {

            // safe way (v3 compatible)
            var removedValue = e.val || (e.object && e.object.id);

            if (removedValue == "28") {
                $("#OtherQuality1").hide();
                $("#OtherQuality").val(""); // optional clear
            }
        });

    });

    $("#closetab").click(function () {
        ClearFields();
    });

    $("#PompSave").click(function () {
        debugger
        var AppID = $("#AppID").val();
        var SubID = $("#SubsID").val();
        var QuaID = $("#QuaID").val();
        //var selectedValue = $('input[name="IsVerified"]:checked').val();
        var data = new FormData();
        var files = $("#ImageUrl").get(0).files;
        if (files.length > 0) {
            data.append("ImageUrl", files[0]);
        }

        var files1 = $("#VideoUrl").get(0).files;
        if (files1.length > 0) {
            data.append("VideoUrl", files1[0]);
        }

        data.append("ComplaintID", $("#CompaintID").text());
        data.append("SaleOfficerName", $("#submittedby").text());
        data.append("StartingDate1", $("#submitteddate").text());
        data.append("ComplaintNumber", $("#complaintno").text());
        data.append("AppID", $("#AppID").val());
        data.append("SubsID", $("#SubsID").val());
        data.append("QuaID", $("#QuaID").val());
        data.append("ComplaintYesNo", $("#ComplaintYesNo").val());
        data.append("ComplaintStatus", $("#ComplaintStatus").val());
        data.append("Remarks", $("#Remarks").val());
        data.append("OtherApplication", $("#OtherApplication").val());
        data.append("OtherSubstrate", $("#OtherSubstrate").val());
        data.append("OtherQuality", $("#OtherQuality").val());

        if (AppID == "" || AppID == null) {
            alertify.error("Please Select Application Cause");
        }
        else if (SubID == "" || SubID == null) {
            alertify.error("Please Select Substrate Cause");
        }
        else if (QuaID == "" || QuaID == null) {
            alertify.error("Please Select Product Quality");
        }
        else {
            $.ajax({
            type: "Post",
            url: "@Url.Action("SaveManageComplaints", "Complaint")",
            cache: false,
            contentType: false,
            processData: false,
            data: data,
            success: function (res) {
                if (res == "1") {
                    alertify.success("Data Added Successfully");
                    $("#ProductDetail").modal('hide');
                    ClearFields();
                    var otable = $("#datatab").DataTable();
                    otable.ajax.reload();
                }
            }

        });
        }
    });

    $(document).on("click", ".quality-delete-btn", function () {
        var rowID = $(this).data("id");
        var ComplaintID = $("#CompaintID").text();
        var ComplaintNo = $("#complaintno").text();
        var SoName = $("#submittedby").text();
        var created = $("#submitteddate").text();
        if (!rowID) {
            return;
        }
        if (confirm("Are you sure you want to delete this quality review entry?")) {
            $.ajax({
                type: "Post",
                url: "@Url.Action("DeleteComplaintSuggestion", "Complaint")",
                data: { ID: rowID },
                success: function (res) {
                    if (res == "1") {
                        alertify.success("Deleted Successfully");
                        // Re-fetch and re-render this complaint's history in place
                        // (modal stays open - the user is managing a list, not a single record).
                        loadQualityHistory(ComplaintID, ComplaintNo, SoName, created);
                        // The outer grid's "latest status" column may change too.
                        var otable = $("#datatab").DataTable();
                        otable.ajax.reload();
                    }
                }
            });
        }
    });

    $(document).on("click", ".quality-publish-btn", function () {
        var rowID = $(this).data("id");
        var ComplaintID = $("#CompaintID").text();
        var ComplaintNo = $("#complaintno").text();
        var SoName = $("#submittedby").text();
        var created = $("#submitteddate").text();
        if (!rowID) {
            return;
        }
        if (confirm("Publish this quality review entry? It will then be included in reports.")) {
            $.ajax({
                type: "Post",
                url: "@Url.Action("PublishComplaintSuggestion", "Complaint")",
                data: { ID: rowID },
                success: function (res) {
                    if (res == "1") {
                        alertify.success("Published Successfully");
                        loadQualityHistory(ComplaintID, ComplaintNo, SoName, created);
                    } else {
                        alertify.error("You are not authorized to publish.");
                    }
                }
            });
        }
    });

    function GenerateDetailGrid() {

        //$('#datatab tfoot th').each(function () {
        //    $(this).html('<input type="text" />');
        //});

        var oTable = $('#datatab').DataTable({
            "aLengthMenu": [[10, 25, 50, 75, 100], [10, 25, 50, 75, 100]],
            "iDisplayLength": 10,
            "searching": false,
            "paging": true,
            "pagingType": "full_numbers",
            "serverSide": true,
            "bRetrieve": true,
            "bDestroy": true,
            "autoWidth": true,
            "ajax": {
                "type": "POST",
                "url": '@Url.Action("ComplaintDataHandler", "Complaint")',
                "contentType": 'application/json; charset=utf-8',
                'data': function (data) {
                    //data.RegionalHeadType = $('#Type').val();
                    data.StartingDate1 = $("#StartingDate1").val();
                    data.StartingDate2 = $("#StartingDate2").val();
                    data.RegionalHeadID = $('#RegionalHeadID').val() == null ? 1 : $('#RegionalHeadID').val();
                    data.ProductNatureID = $('#ProductNatureID').val() == null ? 0 : $('#ProductNatureID').val();
                    data.ComplaintStatusFilter = $('#ComplaintStatusFilter').val() == null ? 0 : $('#ComplaintStatusFilter').val();
                    return data = JSON.stringify(data);
                },
            },
            "fnDrawCallback": function (osetting) {

                var UpdateCheck = "0";
                var DeleteCheck = "0";

                if (UpdateCheck == "@HttpContext.Current.Session["UpdateCheck"]") { $(".edit").css("display", "none"); }
                else {
                    $(".edit").on("click", function () {
                        var ComplaintID = $(this).attr("data-id");
                        var ComplaintNo = $(this).attr("data-complaintNo");
                        var SoName = $(this).attr("data-soname");
                        var created = $(this).attr("data-created");

                        loadQualityHistory(ComplaintID, ComplaintNo, SoName, created);

                        $("html, body").animate({
                            scrollTop: $(window).scrollTop() - $(window).height()
                        }, 400);
                        $("#ProductDetail").modal('show');
                    });
                    }

                if (UpdateCheck == "@HttpContext.Current.Session["DeleteCheck"]") { $(".delete").css("display", "none"); }
                else {
                    $(".delete").on("click", function () {

                        var ComplaintID = $(this).attr("data-id");
                        window.open("@Url.Action("DownloadPDFCompalintReport", "Complaint")" + "?DateTO=" + $("#StartingDate2").val() + " &FromTO=" + $("#StartingDate1").val() + " &ComplaintID=" + ComplaintID);
                    });
                }
            },
            "fnRowCallback": function (nRow, aData, iDisplayIndex) {
                $("td:first", nRow).html(iDisplayIndex + 1);
                return nRow;
            },
            "oLanguage": { "sSearch": "Search Complaints : " },
            "sDom": 'lftipr',
            "processing": true,
            "deferRender": true,
            "bSelect": true,
            "columnDefs": [
                { "width": "60px", "targets": 0 }, // ComplaintID
                { "width": "110px", "targets": 1 }, // StartingDate1
                { "width": "130px", "targets": 2 }, // SaleOfficerName
                { "width": "130px", "targets": 3 }, // CustomerName
                { "width": "130px", "targets": 4 }, // DealerName
                { "width": "120px", "targets": 5 }, // ProductCategory
                { "width": "160px", "targets": 6 }, // ProductDesc
                { "width": "120px", "targets": 7 }, // ProductBatchNo
                { "width": "70px", "targets": 8 }  // Action button
            ],
            "columns": [
                { "data": "ComplaintID"},
                { "data": "ComplaintNumber"},
                { "data": "StartingDate1" },
                { "data": "SaleOfficerName" },
                { "data": "CustomerName" },
                { "data": "DealerName"},
                { "data": "StartingDate2" },
                { "data": "IsVerifiedString"},
            {
                "sClass": "center-align-td",
                "mData": null,
                "bSortable": false,
                "mRender": function (data, type, row) {
                    return '<button class="btn btn-success edit" data-id=' + row.ComplaintID + ' data-complaintNo=' + '"' + row.ComplaintNumber + '"' + ' data-soname=' + '"' + row.SaleOfficerName + '"' + ' data-created=' + '"' + row.StartingDate1 + '"' + '>' + '<i class=icon-pencil></i>' + '</button>&nbsp; <button class="btn btn-primary delete" style="margin-top:5px" data-id=' + row.ComplaintID + '>Report</button>';
                }
            }
            ],
            "order": [1, "asc"]

        });
    }

    $("#ApplyFilter").click(function () {
        var otable = $("#datatab").DataTable();
        otable.ajax.reload();
    });

    function ClearFields() {
        $("#CompaintID").text('');
        $("#submittedby").text('');
        $("#submitteddate").text('');
        $("#complaintno").text('');
        $("#AppID").val([]).trigger("change");
        $("#SubsID").val([]).trigger("change");
        $("#QuaID").val([]).trigger("change");
        $("#Remarks").val('');
        $("#OtherApplication").val('');
        $("#OtherSubstrate").val('');
        $("#OtherQuality").val('');
        $("#OtherApplication1").hide();
        $("#OtherSubstrate1").hide();
        $("#OtherQuality1").hide();
        $("#ComplaintYesNo").val('1');
        $("#ComplaintStatus").val('');
        $("#QualityDataTableBody").empty();
        //val = "True";
        //$('input[name="IsVerified"][value="' + val + '"]')
        //    .prop('checked', true);
    }

    // Minimal HTML-escaping helper so free-text fields (Remarks, names) can never
    // break out of the markup we build via string concatenation below.
    function escapeHtml(value) {
        if (value == null) {
            return '';
        }
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // Fetches the full quality-review history for a complaint (GetSuggestData now
    // returns a JSON array, most-recent-first) and renders:
    //   - the top editable form fields, pre-filled from the most recent entry (res[0])
    //   - every entry as its own row in #QualityDataTableBody
    // Used both when opening the modal (.edit click) and after a per-row delete,
    // so the modal's grid can refresh in place without closing it.
    function loadQualityHistory(ComplaintID, ComplaintNo, SoName, created) {
        $.ajax({
            type: "Get",
            url: "@Url.Action("GetSuggestData", "Complaint")",
            data: { ComplaintID: ComplaintID },
            success: function (res) {
                $("#CompaintID").text(ComplaintID);
                $("#complaintno").text(ComplaintNo);
                $("#submitteddate").text(created);
                $("#submittedby").text(SoName);

                if (!res || res.length === 0) {
                    $("#AppID").val(null).trigger("change");
                    $("#SubsID").val(null).trigger("change");
                    $("#QuaID").val(null).trigger("change");
                    $("#Remarks").val('');
                    $("#OtherApplication").val('');
                    $("#OtherSubstrate").val('');
                    $("#OtherQuality").val('');
                    $("#OtherApplication1").hide();
                    $("#OtherSubstrate1").hide();
                    $("#OtherQuality1").hide();
                    $("#ComplaintYesNo").val('1');
                    $("#ComplaintStatus").val('');

                    $("#QualityDataTableBody").empty();
                    $("#QualityDataTableBody").append(
                        '<tr><td colspan="9" style="text-align:center">No records found</td></tr>'
                    );
                    return;
                }

                var latest = res[0];

                var selected = (latest.AppID || "").split(",");
                $("#AppID").val(selected).trigger("change");
                $("#OtherApplication1").hide();
                for (var i = 0; i < selected.length; i++) {
                    if (selected[i] == "20") {
                        $("#OtherApplication1").show();
                    }
                }
                var selectedsub = (latest.SubsID || "").split(",");
                $("#SubsID").val(selectedsub).trigger("change");
                $("#OtherSubstrate1").hide();
                for (var j = 0; j < selectedsub.length; j++) {
                    if (selectedsub[j] == "17") {
                        $("#OtherSubstrate1").show();
                    }
                }
                var selectedQua = (latest.QuaID || "").split(",");
                $("#QuaID").val(selectedQua).trigger("change");
                $("#OtherQuality1").hide();
                for (var k = 0; k < selectedQua.length; k++) {
                    if (selectedQua[k] == "28") {
                        $("#OtherQuality1").show();
                    }
                }
                $("#Remarks").val(latest.Remarks);
                $("#ComplaintYesNo").val(latest.ComplaintYesNo);
                $("#ComplaintStatus").val(latest.ComplaintStatus || "");

                var rowsHtml = '';
                for (var r = 0; r < res.length; r++) {
                    var item = res[r];
                    var imageCell = item.ImageUrl
                        ? '<a href="' + escapeHtml(item.ImageUrl) + '" target="_blank">View</a>'
                        : '-';
                    var videoCell = item.VideoUrl
                        ? '<a href="' + escapeHtml(item.VideoUrl) + '" target="_blank">View</a>'
                        : '-';

                    var publishCell = '';
                    if (canPublish) {
                        publishCell = item.IsPublished
                            ? '<button type="button" class="btn btn-small" disabled>Published</button>'
                            : '<button type="button" class="btn btn-success btn-small quality-publish-btn" data-id="' + escapeHtml(item.ID) + '">Publish</button>';
                    }

                    rowsHtml += '<tr>' +
                        '<td>' + escapeHtml(item.ApplicationName || '-') + '</td>' +
                        '<td>' + escapeHtml(item.SubstrateName || '-') + '</td>' +
                        '<td>' + escapeHtml(item.QualityName || '-') + '</td>' +
                        '<td>' + escapeHtml(item.Remarks || '-') + '</td>' +
                        '<td>' + escapeHtml(item.IsVerifiedString || '-') + '</td>' +
                        '<td>' + escapeHtml(item.ComplaintStatusString || '-') + '</td>' +
                        '<td>' + imageCell + '</td>' +
                        '<td>' + videoCell + '</td>' +
                        '<td><button type="button" class="btn btn-danger btn-small quality-delete-btn" data-id="' + escapeHtml(item.ID) + '">Delete</button>' + publishCell + '</td>' +
                        '</tr>';
                }

                $("#QualityDataTableBody").empty();
                $("#QualityDataTableBody").append(rowsHtml);
            }
        });
    }

</script>